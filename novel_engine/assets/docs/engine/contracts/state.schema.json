{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State contract 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "world_minute": {
      "type": "integer",
      "minimum": 0
    },
    "versions": {
      "type": "object",
      "properties": {
        "canon_revision": {
          "type": "integer",
          "minimum": 0
        },
        "canon_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "adaptation_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "canon_revision",
        "canon_snapshot",
        "adaptation_version"
      ],
      "additionalProperties": false
    },
    "positions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 0
      }
    },
    "intentions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "kept",
              "rompu"
            ]
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "description",
          "status",
          "references"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "applied_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "state_version",
    "world_minute",
    "versions",
    "positions",
    "knowledge",
    "intentions",
    "resources",
    "commitments",
    "applied_event_ids"
  ],
  "additionalProperties": false
}
