{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal contract 0.2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_state_version": {
      "type": "integer",
      "minimum": 0
    },
    "narration": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      },
      "minItems": 0
    },
    "blocking_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "campaign_id",
    "expected_state_version",
    "narration",
    "events",
    "blocking_questions"
  ],
  "additionalProperties": false
}
