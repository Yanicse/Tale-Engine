{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result contract 0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "recorded",
        "rejected",
        "deferred",
        "question"
      ]
    },
    "state_version_before": {
      "type": "integer",
      "minimum": 0
    },
    "state_version_after": {
      "type": "integer",
      "minimum": 0
    },
    "world_minute_after": {
      "type": "integer",
      "minimum": 0
    },
    "applied_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "world_minute": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "causes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/(positions|knowledge|intentions|resources)/[^/]+$"
                },
                "equals": {}
              },
              "required": [
                "path",
                "equals"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "set",
                    "increment",
                    "remove"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/(positions|knowledge|intentions|resources)/[^/]+$"
                },
                "value": {}
              },
              "required": [
                "operation",
                "path",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "event_id",
          "world_minute",
          "description",
          "causes",
          "conditions",
          "changes",
          "audience"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "narration": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "campaign_id",
    "status",
    "state_version_before",
    "state_version_after",
    "world_minute_after",
    "applied_events",
    "narration",
    "reason"
  ],
  "additionalProperties": false
}
