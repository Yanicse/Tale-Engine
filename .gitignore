# Local private-term list used by tests/test_no_private_traces.py (never commit it)
.private_terms.txt
.export_public.json

# Runtime state: campaigns, canon and source books stay local
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.lock
*.pdf
*.epub
*.zip

# Python and test leftovers
__pycache__/
*.pyc
.tmp-*/

# Your novel packs and campaigns: a pack may quote your book, so none of it is committed
novels/
campaigns/
.routines/

# Build, environments and tool caches
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
